<Window x:Class="AAFSerialCaptureApp.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurações do Gráfico" Height="680" Width="640" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
        <Style TargetType="ListBoxItem" x:Key="StretchedItemStyle">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" Text="Padrão de captura (regex):" FontWeight="Bold" Margin="0,0,0,4" />
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="Aplicar Padrão" Padding="8,2" Margin="6,0,0,0" Click="ApplyRegexButton_Click" />
            <TextBox x:Name="RegexTextBox" FontFamily="Consolas" FontSize="12" TextChanged="RegexTextBox_TextChanged" />
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" Text="Rótulos dos canais (formato: S=Descrição; U=Descrição):" FontWeight="Bold" Margin="0,0,0,4" />
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="Aplicar Rótulos" Padding="8,2" Margin="6,0,0,0" Click="ApplyLabelsButton_Click" />
            <TextBox x:Name="LabelsTextBox" />
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" Text="Perfis salvos (padrão + rótulos, para alternar entre experimentos):"
                   FontWeight="Bold" Margin="0,0,0,4" />
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <Button DockPanel.Dock="Right" Content="Salvar como Perfil" Padding="8,2" Margin="6,0,0,0" Click="SaveProfileButton_Click" />
            <TextBox x:Name="ProfileNameTextBox" />
        </DockPanel>
        <Grid DockPanel.Dock="Top" Height="110" Margin="0,0,0,10">
            <ListBox x:Name="ProfilesListBox" ItemContainerStyle="{StaticResource StretchedItemStyle}"
                     SelectionChanged="ProfilesListBox_SelectionChanged" MouseDoubleClick="ProfilesListBox_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="X" Padding="6,0" FontSize="10" FontWeight="Bold"
                                    ToolTip="Excluir perfil" Tag="{Binding}" Click="DeleteProfileButton_Click" />
                            <Button DockPanel.Dock="Right" Content="Carregar" Padding="6,0" Margin="0,0,4,0" FontSize="10"
                                    ToolTip="Carregar perfil" Tag="{Binding}" Click="LoadProfileButton_Click" />
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <TextBlock DockPanel.Dock="Top" Text="Prévia (aplica o padrão acima às linhas já capturadas/carregadas):"
                   FontWeight="Bold" Margin="0,0,0,4" />
        <TextBox x:Name="PreviewTextBox" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
    </DockPanel>
</Window>

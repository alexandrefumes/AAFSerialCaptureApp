<UserControl x:Class="AAFSerialCaptureApp.Controls.RealTimeChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="White">
    <DockPanel>
        <ItemsControl x:Name="LegendItems" DockPanel.Dock="Top" Margin="4,2">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <Rectangle Width="10" Height="10" Fill="{Binding Color}" Margin="0,0,4,0" />
                        <TextBlock Text="{Binding Text}" FontSize="11" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border BorderBrush="#DDDDDD" BorderThickness="1">
            <Grid x:Name="PlotArea" Background="Transparent" ClipToBounds="True"
                  MouseLeftButtonDown="PlotArea_MouseLeftButtonDown"
                  MouseMove="PlotArea_MouseMove"
                  MouseLeftButtonUp="PlotArea_MouseLeftButtonUp"
                  MouseLeave="PlotArea_MouseLeave"
                  MouseRightButtonDown="PlotArea_MouseRightButtonDown"
                  Cursor="Cross">
                <Canvas x:Name="GridCanvas" Background="Transparent" />
                <Canvas x:Name="BoundaryCanvas" Background="Transparent" IsHitTestVisible="False" />
                <Canvas x:Name="PlotCanvas" Background="Transparent" />
                <Canvas x:Name="PointsCanvas" Background="Transparent" IsHitTestVisible="False" />
                <Rectangle x:Name="SelectionRectangle" Fill="#402E86DE" Stroke="#2E86DE" StrokeThickness="1"
                           HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False" />
                <Button x:Name="ResetZoomButton" Content="Reset Zoom" Padding="6,2" Margin="6"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed"
                        Click="ResetZoomButton_Click" />
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
